{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miku:schema:bake-request:1.1",
  "type": "object",
  "required": ["documentKind", "schemaVersion", "toolVersion", "id", "canonicalHash", "persistentSourceId", "persistentMaterialId", "sourceMaterialName", "sourceSnapshot", "allowAppearanceApproximation", "jobs", "settings"],
  "properties": {
    "documentKind": { "const": "miku-bake-request-1.1" },
    "schemaVersion": { "const": "1.1" },
    "toolVersion": { "type": "string" },
    "id": { "type": "string" },
    "canonicalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "persistentSourceId": { "type": "string", "minLength": 1 },
    "persistentMaterialId": { "type": "string", "minLength": 1 },
    "sourceMaterialName": { "type": "string", "minLength": 1 },
    "sourceSnapshot": { "type": "object" },
    "allowAppearanceApproximation": { "type": "boolean" },
    "meshBinding": { "type": "object" },
    "jobs": { "type": "array", "minItems": 1 },
    "settings": {
      "type": "object",
      "required": ["blenderVersion", "blenderCommit", "engine", "device", "resolution", "samples", "margin", "randomSeed"],
      "properties": {
        "blenderVersion": { "const": "5.2.0 LTS" },
        "blenderCommit": { "const": "fbe6228777e7d9afefcd61a413844e790ae75db7" },
        "engine": { "const": "CYCLES" },
        "device": { "const": "CPU" },
        "resolution": { "enum": [512, 1024, 2048, 4096] },
        "samples": { "const": 16 },
        "margin": { "const": 16 },
        "randomSeed": { "const": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
