{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miku:schema:conversion-plan:1.0",
  "title": "Miku Conversion Plan 1.0",
  "type": "object",
  "required": [
    "documentKind",
    "schemaVersion",
    "toolVersion",
    "id",
    "canonicalHash",
    "materialKey",
    "targetProfile",
    "mode",
    "routePolicy",
    "surfaceModel",
    "surfaceBackend",
    "surfaceModelPlan",
    "closureGraph",
    "weightedClosures",
    "regions",
    "bakeJobs",
    "parameters",
    "diagnostics",
    "completionPolicy"
  ],
  "properties": {
    "documentKind": {"const": "miku-conversion-plan-1.0"},
    "schemaVersion": {"const": "1.0"},
    "toolVersion": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "canonicalHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialKey": {"type": "string", "minLength": 1},
    "targetProfile": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {
      "enum": [
        "Auto",
        "NativeOnly",
        "PreferNative",
        "ReusableBakeOnly",
        "AllowMeshBake",
        "FullPBRBake",
        "AppearanceSnapshot"
      ]
    },
    "routePolicy": {
      "enum": [
        "NativeThenReusableThenMesh",
        "ExplicitSourceMeshFidelity",
        "FixedWorkflowTextureBinding"
      ]
    },
    "surfaceModel": {
      "enum": [
        "OpaquePBR",
        "CutoutPBR",
        "TransparentLit",
        "TransparentEmission",
        "RefractiveGlass",
        "CustomMultiLobe",
        "UnsupportedSurface"
      ]
    },
    "surfaceBackend": {"type": "string"},
    "surfaceModelPlan": {"type": "object"},
    "closureGraph": {"type": "object"},
    "weightedClosures": {"type": "object"},
    "regions": {"type": "array"},
    "bakeJobs": {"type": "array"},
    "parameters": {"type": "array"},
    "diagnostics": {"type": "array"},
    "completionPolicy": {"type": "object"}
  },
  "additionalProperties": false
}
